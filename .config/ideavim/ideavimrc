let mapleader=" "

""" Plugins  --------------------------------
set which-key
set notimeout
set timeoutlen=5000

let g:WhichKey_ShowVimActions = "true"

set surround
set multiple-cursors
set commentary
set argtextobj
set easymotion
set textobj-entire

""" Plugin settings -------------------------
let g:argtextobj_pairs="[:],(:),<:>"

""" Common settings -------------------------
set hlsearch
set ignorecase
set smartcase
set showmode
set so=5
set incsearch
set nu

""" Idea specific settings ------------------

set ideajoin
set ideastatusicon=gray
set idearefactormode=keep

""" Mappings --------------------------------
imap jk <Esc>

nmap <leader>e <Action>(ShowErrorDescription)
nmap <leader>q <Action>(ActivateProblemsViewToolWindow)

nmap <c-h> <c-w><c-h>
nmap <c-j> <c-w><c-j>
nmap <c-k> <c-w><c-k>
nmap <c-l> <c-w><c-l>

nmap <leader>sf <Action>(GotoFile)
nmap <leader>s. <Action>(RecentFiles)

map <c-y> <Action>(EditorChooseLookupItem)

" lsp stuff
nmap gd <Action>(GotoDeclaration)
nmap gr <Action>(FindUsages)
nmap gI <Action>(GotoImplementation)
nmap <leader>D <Action>(GotoTypeDeclaration)
" nmap <leader>ds search file for symbols
nmap <leader>ws <Action>(GotoSymbol)
nmap <leader>rn <Action>(RenameElement)
nmap <leader>ca <Action>(ShowIntentionActions)

nmap ]d <Action>(GotoNextError)
nmap [d <Action>(GotoPreviousError)
nmap ]g <Action>(VcsShowNextChangeMarker)
nmap [g <Action>(VcsShowPrevChangeMarker)

