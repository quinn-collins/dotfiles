[branch]
        sort = -committerdate
[column]
        ui = auto
[commit]
        verbose = true
[core]
        # fsmonitor = true
        # untrackedCache = true
[diff]
        algorithm = histogram
        colorMoved = plain
        mnemonicPrefix = true
        renames = true
[fetch]
        prune = true
        # pruneTags = true
        all = true
[help]
        autocorrect = prompt
[init]
        defaultBranch = main
[merge]
        # (just 'diff3' if git version < 2.3)
        # conflictstyle = zdiff3 
[pull]
        rebase = true
[push]
        autoSetupRemote = true
        followTags = true
[rebase]
        autoSquash = true
        autoStash = true
        # updateRefs = true
[rerere]
        enabled = true
        autoupdate = true
[tag]
        sort = version:refname
[user]
	email = quinn.collins@interfolio.com
	name = quinncollins-interfolio
[includeIf "gitdir:~/dev/workspaces/"]
	path = ~/dev/workspaces/.work.gitconfig
[includeIf "gitdir:~/dev/personal/"]
	path = ~/dev/personal/.personal.gitconfig
[url "git@github.com:"]
	insteadOf = https://github.com/
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
